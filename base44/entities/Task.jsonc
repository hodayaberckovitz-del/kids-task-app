{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05e0\u05d5\u05e1\u05e3 \u05dc\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "icon": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d0\u05d9\u05d9\u05e7\u05d5\u05df \u05de-lucide-react"
    },
    "color": {
      "type": "string",
      "description": "\u05e6\u05d1\u05e2 \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    },
    "visual_image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05d4 \u05de\u05d5\u05de\u05d7\u05e9\u05ea \u05d2\u05d3\u05d5\u05dc\u05d4"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "morning",
        "evening",
        "star",
        "timed"
      ],
      "default": "morning"
    },
    "base_tokens": {
      "type": "number",
      "default": 1
    },
    "star_tokens": {
      "type": "number",
      "default": 15
    },
    "duration_minutes": {
      "type": "number"
    },
    "timed_tokens": {
      "type": "number"
    },
    "input_type": {
      "type": "string",
      "enum": [
        "checkbox",
        "text",
        "timer",
        "backpack_checklist"
      ],
      "default": "checkbox"
    },
    "input_label": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "he",
        "en",
        "ru",
        "ar"
      ]
    },
    "child_profile_id": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "is_shared": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05de\u05e9\u05d5\u05ea\u05e4\u05ea \u05dc\u05db\u05de\u05d4 \u05d9\u05dc\u05d3\u05d9\u05dd"
    },
    "shared_child_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea IDs \u05e9\u05dc \u05d9\u05dc\u05d3\u05d9\u05dd \u05e9\u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05dc\u05d1\u05e6\u05e2 \u05d0\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    }
  },
  "required": [
    "title",
    "icon",
    "color",
    "family_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "family_id": "{{user.family_id}}"
    },
    "update": {
      "$or": [
        {
          "family_id": "{{user.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "family_id": "{{user.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}