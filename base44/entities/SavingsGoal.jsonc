{
  "name": "SavingsGoal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d9\u05e2\u05d3 \u05d4\u05d7\u05d9\u05e1\u05db\u05d5\u05df"
    },
    "target_amount": {
      "type": "number",
      "description": "\u05d9\u05e2\u05d3 \u05d4\u05d0\u05e1\u05d9\u05de\u05d5\u05e0\u05d9\u05dd \u05dc\u05d7\u05d9\u05e1\u05db\u05d5\u05df"
    },
    "current_amount": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05db\u05d5\u05dd \u05e0\u05d5\u05db\u05d7\u05d9 \u05d1\u05d7\u05d9\u05e1\u05db\u05d5\u05df"
    },
    "image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05d9\u05e2\u05d3 \u05d4\u05d7\u05d9\u05e1\u05db\u05d5\u05df"
    },
    "is_completed": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d2\u05d9\u05e2 \u05dc\u05d9\u05e2\u05d3"
    },
    "child_profile_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05d9\u05dc\u05d3"
    },
    "family_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05e4\u05d7\u05d4"
    }
  },
  "required": [
    "title",
    "target_amount",
    "child_profile_id",
    "family_id"
  ],
  "rls": {
    "create": {
      "family_id": "{{user.family_id}}"
    },
    "read": {
      "family_id": "{{user.family_id}}"
    },
    "update": {
      "family_id": "{{user.family_id}}"
    },
    "delete": {
      "family_id": "{{user.family_id}}"
    }
  }
}